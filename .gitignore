# Python
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Crush tool workspace data
.crush/

# Runtime staging + exports (uploaded catalog pairs are runtime state; keep the
# directory itself via .gitkeep). Intentional examples live in samples/.
catalog_studio/uploads/*
!catalog_studio/uploads/.gitkeep
catalog_studio/exports/*

# Vendor reference documentation (Autodesk guides/handouts) kept locally only:
# copyrighted material and large binaries, never committed.
docs/references/

# Pre-change database snapshots (runtime only)
catalog_studio/snapshots/

# Delivered Astor library samples stay local (large binaries, not for
# distribution); only the curated sample pairs are tracked.
samples/Astor*.mdf
samples/Astor*_log.ldf
